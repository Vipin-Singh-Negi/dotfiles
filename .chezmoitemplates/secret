{{- /*
  Secret backend abstraction. NEVER call rbw/bitwarden directly in a template.

  Usage:
    {{ includeTemplate "secret" (dict "item" "github-token" "ctx" .) }}

  Backends:
    rbw  - Linux / macOS / WSL   (fast, keyring-backed agent)
    bw   - native Windows        (official CLI; rbw is cargo-only there)
*/ -}}
{{- $item := .item -}}
{{- $ctx  := .ctx  -}}
{{- if $ctx.ciMode -}}
CI_PLACEHOLDER
{{- else if eq $ctx.secretBackend "bw" -}}
{{- (bitwarden "item" $item).login.password -}}
{{- else -}}
{{- (rbw $item).data.password -}}
{{- end -}}
