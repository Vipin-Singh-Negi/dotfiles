#-------------------------------------------------------------------------------
# zshrc - managed by chezmoi. Edit with: chezmoi edit ~/.zshrc
#-------------------------------------------------------------------------------

# ---------- oh-my-zsh ----------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
plugins=(git docker kubectl)
[ -d "$ZSH" ] && source "$ZSH/oh-my-zsh.sh"

# ---------- prompt ----------
autoload -U promptinit && promptinit
prompt pure 2>/dev/null || PS1='%F{blue}%~%f %# '

# ---------- history ----------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS HIST_VERIFY SHARE_HISTORY
setopt EXTENDED_HISTORY INC_APPEND_HISTORY HIST_IGNORE_SPACE

# ---------- editor ----------
export EDITOR="$(command -v nvim >/dev/null && echo nvim || echo vim)"
export VISUAL="$EDITOR"

# ---------- path ----------
typeset -U path
path=("$HOME/{{ if .isWindows }}bin{{ else }}.local/bin{{ end }}" "$HOME/go/bin" $path)
export PATH

{{ if .isDarwin -}}
# ---------- macOS toolchains ----------
if /usr/libexec/java_home -v 17 >/dev/null 2>&1; then
  export JAVA_HOME="$(/usr/libexec/java_home -v 17)"
  path=("$JAVA_HOME/bin" $path)
fi

if [ -d "$HOME/Library/Android/sdk" ]; then
  export ANDROID_HOME="$HOME/Library/Android/sdk"
  export ANDROID_SDK_ROOT="$ANDROID_HOME"
  path=(
    "$ANDROID_HOME/platform-tools"
    "$ANDROID_HOME/cmdline-tools/latest/bin"
    "$ANDROID_HOME/emulator"
    $path
  )
fi

# Antigravity (path derived, never hardcoded)
[ -d "$HOME/.antigravity/antigravity/bin" ] && path=("$HOME/.antigravity/antigravity/bin" $path)
export PATH
{{ end -}}

# ---------- ssh agent ----------
# NOTE: `eval $(ssh-agent -s)` in a shell rc spawns a NEW agent per terminal and
# leaks processes. On macOS the launchd agent + `AddKeysToAgent`/`UseKeychain`
# in ~/.ssh/config handles this. Elsewhere, reuse one agent per user.
{{ if not .isDarwin -}}
if [ -z "${SSH_AUTH_SOCK:-}" ] || ! ssh-add -l >/dev/null 2>&1; then
  __agent_env="$HOME/.ssh/agent.env"
  [ -f "$__agent_env" ] && . "$__agent_env" >/dev/null
  if ! ssh-add -l >/dev/null 2>&1; then
    (umask 077; ssh-agent -s > "$__agent_env")
    . "$__agent_env" >/dev/null
  fi
  unset __agent_env
fi
{{ end -}}

# ---------- secrets ----------
{{ if .enableSecrets -}}
# Tier-Low secrets, rendered once at apply time (never call the vault in an rc).
[ -f "$HOME/.config/env.sh" ] && source "$HOME/.config/env.sh"
{{ end -}}

# Tier-High secrets stay in the vault and are fetched on demand.
secret() {
  emulate -L zsh
  [ -n "$1" ] || { print -u2 "usage: secret <item>"; return 2; }
  rbw get "$1" 2>/dev/null || { print -u2 "secret: vault locked or item '$1' not found"; return 1; }
}

# ---------- aliases ----------
alias dsa="cd ~/Documents/personal/dsa"
alias oo="copilot --yolo"
alias vim="$EDITOR"
alias ll="ls -lah"
alias gs="git status -sb"
alias gd="git diff"
alias gl="git log --oneline --graph --decorate -20"

# chezmoi workflow: explicit diff gate, no auto-push
alias cz="chezmoi"
alias cze="chezmoi edit --apply"
alias czd="chezmoi diff"
alias cza="chezmoi apply -v"
alias czu="chezmoi update -v"
alias czcd="chezmoi cd"
czsync() {
  chezmoi cd && git add -A && git diff --cached && \
    { print -n "commit & push? [y/N] "; read -q _r; print; [ "$_r" = y ] && git commit && git push; }
}

command -v eza >/dev/null && alias ls="eza --group-directories-first"
command -v bat >/dev/null && alias cat="bat --paging=never"

# ---------- integrations ----------
command -v zoxide  >/dev/null && eval "$(zoxide init zsh)"
command -v direnv  >/dev/null && eval "$(direnv hook zsh)"
[ -f "$HOME/.fzf.zsh" ] && source "$HOME/.fzf.zsh"

# ---------- machine-local overrides (never committed) ----------
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
