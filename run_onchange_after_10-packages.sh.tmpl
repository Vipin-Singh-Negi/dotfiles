#!/usr/bin/env bash
set -euo pipefail
# packages hash: {{ .packages | toJson | sha256sum }}
# run_onchange_ + this hash means editing .chezmoidata/packages.yaml
# re-provisions every machine on its next apply.

echo "==> Provisioning packages ({{ .chezmoi.os }})"

{{ if .isDarwin -}}
if ! command -v brew >/dev/null 2>&1; then
  echo "Homebrew missing; run bootstrap.sh first." >&2
  exit 1
fi
brew install {{ .packages.darwin.brew | join " " }}
{{ if .isGui -}}
brew install --cask {{ .packages.darwin.cask | join " " }} || true
{{ end -}}

{{ else if eq .chezmoi.os "linux" -}}
if command -v apt-get >/dev/null 2>&1; then
  sudo apt-get update -qq
  sudo apt-get install -y {{ .packages.linux.apt | join " " }}
elif command -v pacman >/dev/null 2>&1; then
  sudo pacman -S --needed --noconfirm {{ .packages.linux.pacman | join " " }}
elif command -v dnf >/dev/null 2>&1; then
  sudo dnf install -y {{ .packages.linux.apt | join " " }}
else
  echo "No supported package manager found." >&2
fi
{{ end -}}

echo "==> Packages done"
